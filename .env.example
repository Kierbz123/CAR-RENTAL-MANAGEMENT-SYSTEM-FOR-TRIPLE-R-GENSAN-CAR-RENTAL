# PHP application timezone; daily recipient budgets reset at local midnight.
APP_TIMEZONE=Asia/Manila
# MySQL database host, port, and schema.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=triple_r_rental
# Runtime account: SELECT/INSERT/UPDATE only. It cannot remove append-only events or triggers.
DB_USER=triple_r_app
DB_PASSWORD=replace-with-a-long-password
# Private runtime and worker output directory; keep it outside the public/ document root.
STORAGE_PATH=storage
# Addresses of tunnels or reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers are believed
# (comma-separated). Leave empty when visitors connect to the web server directly. bin/demo-online.ps1
# sets this to 127.0.0.1,::1 for its own run, so it does not need to be set here for a presentation.
TRUSTED_PROXIES=
# Public application origin used in SMS links. Use HTTPS in production.
APP_BASE_URL=http://127.0.0.1:8000
# First administrator created by bin/seed.php; change the example password before seeding.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=ChangeMe-Now-123!
# Number of consecutive credential failures before an account is locked; only an administrator can unlock it.
AUTH_MAX_FAILED_LOGINS=5
# Persisted staff-session lifetime in seconds (12 hours by default).
AUTH_SESSION_TTL_SECONDS=43200
# Choose semaphore or philsms; all SMS requests use this provider adapter.
SMS_PROVIDER=semaphore
# Maximum messages queued to one phone per local calendar day, across priorities.
SMS_DAILY_LIMIT_PER_PHONE=10
# Provider attempts before a retryable notification becomes terminally failed.
SMS_MAX_ATTEMPTS=5
# Dedicated base64-encoded 32-byte AES-256-GCM key for sensitive queued SMS bodies.
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
SMS_CIPHER_KEY=
# Optional previous SMS_CIPHER_KEY during a rotation while old encrypted rows remain in the queue table.
SMS_CIPHER_KEY_PREVIOUS=
# Dedicated base64-encoded 32-byte key for customer contacts and identity documents.
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
CUSTOMER_PII_KEY=
# Dedicated base64-encoded 32-byte key for driver license, contact, address, and emergency-contact PII.
# Generate separately from CUSTOMER_PII_KEY with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
DRIVER_PII_KEY=
# Magic-link lifetime is capped at 48 hours and further capped at a linked booking hold.
MAGIC_LINK_TTL_SECONDS=172800
MAGIC_LINK_MAX_PER_CONTACT_24H=10
# Includes the initial link plus up to five re-sends over the booking lifetime.
MAGIC_LINK_MAX_PER_BOOKING=6
MAGIC_LINK_VERIFY_PER_IP_PER_HOUR=20
MAGIC_LINK_VERIFY_PER_TOKEN_PER_HOUR=10
# How long a new reservation holds its vehicle while the customer pays the 30% downpayment
# (1 to 1440 minutes). A recorded downpayment stops the clock. Independent from the no-show grace period.
RESERVATION_HOLD_MINUTES=1440
# Online payment gateway. "simulated" is the demonstration checkout: the customer picks GCash, Maya,
# GrabPay, a card or online banking, and the checkout shows what happens when the payment is approved,
# declined, cancelled or left to time out. NO REAL MONEY MOVES. Leave empty (or "none") to switch paying
# online off; the proof upload and payments recorded at the counter work either way.
PAYMENT_GATEWAY=
# Shared secret that signs the gateway's results, so a forged "paid" message is refused (16+ characters).
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
PAYMENT_WEBHOOK_SECRET=
# Minutes a customer has to finish a checkout before it times out (1 to 120; never past the end of the hold).
PAYMENT_PENDING_MINUTES=15
# Confirmed pickup cutoff before a no-show may be recorded.
NO_SHOW_GRACE_MINUTES=60
# Non-transactional SMS remains policy-suppressed until affirmative opt-in capture is implemented.
NON_TRANSACTIONAL_SMS_ENABLED=false
# Semaphore API key and an optional sender name already registered with Semaphore.
SMS_SEMAPHORE_API_KEY=
SMS_SEMAPHORE_SENDER_NAME=
# PhilSMS API token and its registered sender ID.
SMS_PHILSMS_API_TOKEN=
SMS_PHILSMS_SENDER_ID=
# Random shared webhook secret used for HMAC-SHA256 callback verification.
SMS_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Telegram notifications (optional). A connected customer gets their messages in Telegram instead of by SMS.
# Create the bot yourself in Telegram: message @BotFather, send /newbot, and copy the token it gives you.
# Keep the token secret: anyone who has it can read and send messages as the bot.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @, exactly as BotFather shows it (it ends in "bot").
TELEGRAM_BOT_USERNAME=
# How long a customer's one-time connection code stays valid.
TELEGRAM_LINK_CODE_TTL_MINUTES=15
