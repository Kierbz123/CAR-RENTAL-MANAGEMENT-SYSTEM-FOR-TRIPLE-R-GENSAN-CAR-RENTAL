# PHP application timezone; daily recipient budgets reset at local midnight.
APP_TIMEZONE=Asia/Manila
# MySQL database host, port, and schema.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=triple_r_rental
# Runtime account: SELECT/INSERT/UPDATE only. It cannot remove append-only events or triggers.
DB_USER=triple_r_app
DB_PASSWORD=replace-with-a-long-password
# Private runtime and worker output directory; keep it outside the public/ document root.
STORAGE_PATH=storage
# First administrator created by bin/seed.php; change the example password before seeding.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=ChangeMe-Now-123!
# Choose semaphore or philsms; all SMS requests use this provider adapter.
SMS_PROVIDER=semaphore
# Maximum messages queued to one phone per local calendar day, across priorities.
SMS_DAILY_LIMIT_PER_PHONE=10
# Provider attempts before a retryable notification becomes terminally failed.
SMS_MAX_ATTEMPTS=5
# Semaphore API key and an optional sender name already registered with Semaphore.
SMS_SEMAPHORE_API_KEY=
SMS_SEMAPHORE_SENDER_NAME=
# PhilSMS API token and its registered sender ID.
SMS_PHILSMS_API_TOKEN=
SMS_PHILSMS_SENDER_ID=
# Random shared webhook secret used for HMAC-SHA256 callback verification.
SMS_WEBHOOK_SECRET=replace-with-a-long-random-secret
